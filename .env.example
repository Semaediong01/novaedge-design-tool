# Copy to .env.local for local work. On Vercel, add the same names under Project -> Settings -> Environment Variables.
# Never commit real keys.

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" key or the newer "publishable" key. Both work here and both are safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" / secret key. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack -> Settings -> API Keys & Webhooks (use the TEST secret key first)
PAYSTACK_SECRET_KEY=

# Your public site address, no trailing slash (http://localhost:3000 locally)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
